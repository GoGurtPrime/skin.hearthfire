<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Weather "Cabin Window". -->
<window>
    <defaultcontrol always="true">20</defaultcontrol>
    <controls>
        <include content="hf_BackdropStackCurated">
            <param name="image">$INFO[Weather.Conditions,extras/backdrops/bg_weather_,.jpg]</param>
        </include>
        <control type="label">
            <posx>$CONST[hf_margin_x]</posx>
            <posy>160</posy>
            <width>600</width>
            <height>96</height>
            <font>hf_hero</font>
            <textcolor>hf_cream</textcolor>
            <label>$INFO[Weather.Temperature]</label>
        </control>
        <control type="label">
            <posx>$CONST[hf_margin_x]</posx>
            <posy>260</posy>
            <width>600</width>
            <height>48</height>
            <font>hf_section</font>
            <textcolor>hf_parchment</textcolor>
            <label>$INFO[Weather.Conditions]</label>
        </control>
        <control type="label">
            <posx>$CONST[hf_margin_x]</posx>
            <posy>316</posy>
            <width>700</width>
            <height>32</height>
            <font>hf_meta</font>
            <textcolor>hf_smoke</textcolor>
            <label>$INFO[Weather.Humidity] · $INFO[Weather.Wind] · $INFO[Weather.SunRise] - $INFO[Weather.SunSet]</label>
        </control>
        <control type="list" id="20">
            <posx>$CONST[hf_margin_x]</posx>
            <posy>760</posy>
            <width>1728</width>
            <height>200</height>
            <orientation>horizontal</orientation>
            <itemgap>$CONST[hf_sp_4]</itemgap>
            <itemlayout height="180" width="320">
                <control type="image">
                    <texture colordiffuse="hf_walnut" border="16">ui/rounded6.png</texture>
                </control>
                <control type="label">
                    <posy>16</posy>
                    <width>320</width>
                    <height>32</height>
                    <align>center</align>
                    <font>hf_label</font>
                    <textcolor>hf_cream</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <posy>120</posy>
                    <width>320</width>
                    <height>32</height>
                    <align>center</align>
                    <font>hf_meta</font>
                    <textcolor>hf_parchment</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </itemlayout>
        </control>
    </controls>
</window>