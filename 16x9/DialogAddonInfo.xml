<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Add-on info, Program Card pattern. Required: id=300 grouplist, id=6 Install, id=7 Disable,
    id=8 Update, id=13 Auto-update toggle, id=9 Settings, id=10 Dependencies, id=12 Use this version. -->
<window>
    <defaultcontrol always="true">300</defaultcontrol>
    <controls>
        <control type="image">
            <width>$CONST[hf_canvas_w]</width><height>$CONST[hf_canvas_h]</height>
            <texture colordiffuse="hf_scrim_90">ui/white.png</texture>
        </control>
        <control type="image">
            <posx>96</posx><posy>96</posy><width>400</width><height>400</height>
            <aspectratio>scale</aspectratio>
            <texture fallback="defaults/DefaultAddon.png">$INFO[ListItem.Icon]</texture>
        </control>
        <control type="image">
            <posx>96</posx><posy>96</posy><width>400</width><height>400</height>
            <texture border="10">ui/rim_ember.png</texture>
        </control>
        <control type="label">
            <posx>560</posx><posy>96</posy><width>1260</width><height>64</height>
            <font>hf_page</font><textcolor>hf_cream</textcolor><label>$INFO[ListItem.Label]</label>
        </control>
        <control type="label">
            <posx>560</posx><posy>164</posy><width>1260</width><height>32</height>
            <font>hf_meta</font><textcolor>hf_parchment</textcolor><label>$INFO[ListItem.Property(Addon.Version)] · $INFO[ListItem.Property(Addon.Creator)]</label>
        </control>
        <control type="textbox">
            <posx>560</posx><posy>212</posy><width>1200</width><height>200</height>
            <font>hf_body</font><textcolor>hf_parchment</textcolor><label>$INFO[ListItem.Property(Addon.Description)]</label>
        </control>
        <control type="grouplist" id="300">
            <posx>560</posx><posy>460</posy><orientation>horizontal</orientation><itemgap>16</itemgap><width>1260</width><height>72</height>
            <include content="hf_ButtonPrimary"><param name="id">6</param><param name="label">1024</param><param name="onclick">Addon.Install</param></include>
            <control type="button" id="8"><width>180</width><height>64</height><label>24068</label><font>hf_label</font><align>center</align><aligny>center</aligny><texturefocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturefocus><texturenofocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturenofocus></control>
            <control type="button" id="9"><width>180</width><height>64</height><label>24021</label><font>hf_label</font><align>center</align><aligny>center</aligny><texturefocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturefocus><texturenofocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturenofocus></control>
            <control type="button" id="10"><width>180</width><height>64</height><label>39024</label><font>hf_label</font><align>center</align><aligny>center</aligny><texturefocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturefocus><texturenofocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturenofocus></control>
            <control type="button" id="12"><width>180</width><height>64</height><label>21362</label><font>hf_label</font><align>center</align><aligny>center</aligny><texturefocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturefocus><texturenofocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturenofocus></control>
            <control type="button" id="7"><width>180</width><height>64</height><label>24021</label><font>hf_label</font><align>center</align><aligny>center</aligny><texturefocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturefocus><texturenofocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturenofocus></control>
            <control type="radiobutton" id="13"><width>180</width><height>64</height><label>24066</label><font>hf_meta</font><align>left</align><aligny>center</aligny><texturenofocus colordiffuse="00FFFFFF">ui/white.png</texturenofocus><texturefocus colordiffuse="hf_timber" border="10">ui/rounded6.png</texturefocus></control>
        </control>
    </controls>
</window>