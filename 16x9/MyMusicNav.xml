<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Music library shell, reuses the view family. -->
<window>
    <defaultcontrol always="true">50</defaultcontrol>
    <views>50,51,52,53,54</views>
    <controls>
        <include>hf_BackdropStack</include>
        <control type="label">
            <posx>$CONST[hf_margin_x]</posx><posy>$CONST[hf_margin_top]</posy><width>1200</width><height>64</height>
            <font>hf_page</font><textcolor>hf_cream</textcolor><label>$INFO[Container.FolderName]</label>
        </control>
        <include>View_50</include>
        <include>View_51</include>
        <include>View_52</include>
        <include>View_53</include>
        <include>View_54</include>
    </controls>
</window>