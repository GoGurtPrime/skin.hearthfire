<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- "Lights Out?" power menu. Kodi loads this exact file for the built-in shutdownmenu window
    (id 111); no custom window id is needed. Required ids: list id=1 (button list Kodi populates with the
    available power actions). -->
<window>
    <defaultcontrol always="true">1</defaultcontrol>
    <controls>
        <include content="hf_HearthCard_Confirm"><param name="height">440</param><param name="posy">320</param></include>
        <control type="label">
            <posx>648</posx>
            <posy>352</posy>
            <width>624</width>
            <height>48</height>
            <font>hf_section</font>
            <textcolor>hf_cream</textcolor>
            <label>31070</label>
        </control>
        <control type="list" id="1">
            <posx>648</posx>
            <posy>420</posy>
            <width>624</width>
            <height>280</height>
            <scrolltime>200</scrolltime>
            <itemlayout height="56" width="624">
                <control type="label">
                    <width>624</width>
                    <height>56</height>
                    <aligny>center</aligny>
                    <font>hf_label</font>
                    <textcolor>hf_cream</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout height="56" width="624">
                <include content="hf_FocusFill" />
                <control type="label">
                    <posx>16</posx>
                    <width>608</width>
                    <height>56</height>
                    <aligny>center</aligny>
                    <font>hf_label</font>
                    <textcolor>hf_flame</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>