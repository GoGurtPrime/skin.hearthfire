<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Hearth Card select/multi-select dialog. Required id: label id=1 (heading), list
    id=3 (items), grouplist id=9000 for optional footer buttons. -->
<window>
    <defaultcontrol always="true">3</defaultcontrol>
    <controls>
        <include content="hf_HearthCard_Select"><param name="height">760</param><param name="posy">160</param></include>
        <control type="label" id="1">
            <posx>520</posx>
            <posy>192</posy>
            <width>880</width>
            <height>48</height>
            <font>hf_section</font>
            <textcolor>hf_cream</textcolor>
        </control>
        <control type="list" id="3">
            <posx>520</posx>
            <posy>256</posy>
            <width>880</width>
            <height>600</height>
            <scrolltime>200</scrolltime>
            <itemlayout height="72" width="880">
                <include content="hf_ListRow" />
                <control type="label">
                    <posx>16</posx>
                    <width>848</width>
                    <height>72</height>
                    <aligny>center</aligny>
                    <font>hf_label</font>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout height="72" width="880">
                <include content="hf_FocusFill" />
                <control type="label">
                    <posx>16</posx>
                    <width>848</width>
                    <height>72</height>
                    <aligny>center</aligny>
                    <font>hf_label</font>
                    <textcolor>hf_flame</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>