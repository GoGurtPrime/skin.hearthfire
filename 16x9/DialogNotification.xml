<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Toast notification. Required ids: label id=401 (header), label id=402 (message),
    image id=403 (icon). -->
<window>
    <controls>
        <control type="group">
            <posx>1416</posx>
            <posy>64</posy>
            <animation effect="slide" start="480,0" end="0,0" time="$CONST[hf_t_ui]" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="$CONST[hf_t_ui]">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
            <control type="image">
                <width>480</width>
                <height>88</height>
                <texture colordiffuse="hf_walnut" border="16">ui/rounded6.png</texture>
            </control>
            <control type="image">
                <width>4</width>
                <height>88</height>
                <texture colordiffuse="hf_ember">ui/white.png</texture>
            </control>
            <control type="image" id="403">
                <posx>24</posx>
                <posy>24</posy>
                <width>40</width>
                <height>40</height>
            </control>
            <control type="label" id="401">
                <posx>80</posx>
                <posy>16</posy>
                <width>380</width>
                <height>32</height>
                <font>hf_label</font>
                <textcolor>hf_cream</textcolor>
            </control>
            <control type="label" id="402">
                <posx>80</posx>
                <posy>48</posy>
                <width>380</width>
                <height>32</height>
                <font>hf_meta</font>
                <textcolor>hf_parchment</textcolor>
            </control>
        </control>
    </controls>
</window>