<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Required (marked "Do not change id or type" in reference skins): id=110 service logo image,
    id=111 group wrapping the no-results notice, id=100 active-service header label, id=120 results list. -->
<window>
    <defaultcontrol always="true">120</defaultcontrol>
    <controls>
        <include content="hf_HearthCard_Select"><param name="height">680</param><param name="posy">200</param></include>
        <control type="label">
            <posx>520</posx><posy>232</posy><width>880</width><height>40</height>
            <font>hf_section</font><textcolor>hf_cream</textcolor><label>24117</label>
        </control>
        <control type="image" id="110">
            <posx>520</posx><posy>288</posy><width>48</width><height>48</height>
        </control>
        <control type="label" id="100">
            <posx>580</posx><posy>288</posy><width>600</width><height>48</height>
            <font>hf_label</font><textcolor>hf_parchment</textcolor><aligny>center</aligny>
        </control>
        <control type="group" id="111">
            <posx>520</posx><posy>352</posy>
            <control type="label">
                <width>880</width><height>40</height>
                <font>hf_body</font><textcolor>hf_smoke</textcolor><label>24114</label>
            </control>
        </control>
        <control type="list" id="120">
            <posx>520</posx><posy>352</posy><width>880</width><height>320</height>
            <itemlayout height="56" width="880"><control type="label"><width>880</width><height>56</height><aligny>center</aligny><font>hf_label</font><label>$INFO[ListItem.Label]</label></control></itemlayout>
            <focusedlayout height="56" width="880"><include content="hf_FocusFill" /><control type="label"><posx>16</posx><width>864</width><height>56</height><aligny>center</aligny><font>hf_label</font><textcolor>hf_flame</textcolor><label>$INFO[ListItem.Label]</label></control></focusedlayout>
        </control>
    </controls>
</window>