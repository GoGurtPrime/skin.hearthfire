<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Media flags : a row of brass-tone chips. Only show what exists. -->
<includes>
    <include name="hf_MediaFlags">
        <definition>
            <control type="group">
                <control type="label">
                    <visible>!String.IsEmpty(ListItem.VideoResolution)</visible>
                    <width>80</width>
                    <height>32</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>hf_caption</font>
                    <textcolor>hf_parchment</textcolor>
                    <texturebg colordiffuse="hf_timber" border="10">ui/rounded6.png</texturebg>
                    <label>$INFO[ListItem.VideoResolution]</label>
                </control>
                <control type="label">
                    <posx>88</posx>
                    <visible>!String.IsEmpty(ListItem.VideoHdrType)</visible>
                    <width>100</width>
                    <height>32</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>hf_caption</font>
                    <textcolor>hf_parchment</textcolor>
                    <texturebg colordiffuse="hf_timber" border="10">ui/rounded6.png</texturebg>
                    <label>$INFO[ListItem.VideoHdrType]</label>
                </control>
                <control type="label">
                    <posx>196</posx>
                    <visible>!String.IsEmpty(ListItem.AudioCodec)</visible>
                    <width>140</width>
                    <height>32</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>hf_caption</font>
                    <textcolor>hf_parchment</textcolor>
                    <texturebg colordiffuse="hf_timber" border="10">ui/rounded6.png</texturebg>
                    <label>$INFO[ListItem.AudioCodec] $INFO[ListItem.AudioChannels]</label>
                </control>
            </control>
        </definition>
    </include>
</includes>