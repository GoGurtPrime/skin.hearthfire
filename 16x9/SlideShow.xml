<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Slideshow : black backdrop, small filename/date chip. -->
<window>
    <controls>
        <control type="image">
            <width>$CONST[hf_canvas_w]</width>
            <height>$CONST[hf_canvas_h]</height>
            <texture colordiffuse="hf_char">ui/white.png</texture>
        </control>
        <control type="image" id="2">
            <width>$CONST[hf_canvas_w]</width>
            <height>$CONST[hf_canvas_h]</height>
            <aspectratio>keep</aspectratio>
        </control>
        <control type="label">
            <posx>$CONST[hf_margin_x]</posx>
            <posy>984</posy>
            <width>1200</width>
            <height>32</height>
            <font>hf_caption</font>
            <textcolor>hf_parchment</textcolor>
            <label>$INFO[Slideshow.Filename] · $INFO[Slideshow.Exif(Date)]</label>
        </control>
    </controls>
</window>