<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Thin top-center volume bar, 2s dwell. -->
<window>
    <controls>
        <control type="group">
            <posx>760</posx>
            <posy>48</posy>
            <animation effect="fade" start="0" end="100" time="$CONST[hf_t_fast]">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
            <control type="image">
                <width>400</width><height>32</height>
                <texture colordiffuse="hf_walnut" border="10">ui/rounded6.png</texture>
            </control>
            <control type="progress" id="20">
                <posx>16</posx><posy>8</posy><width>368</width><height>16</height>
                <info>Player.Volume</info>
                <texturebg colordiffuse="hf_timber" border="3">ui/rounded6.png</texturebg>
                <lefttexture colordiffuse="hf_ember" border="3">ui/rounded6.png</lefttexture>
                <midtexture colordiffuse="hf_ember">ui/white.png</midtexture>
                <righttexture colordiffuse="hf_flame" border="3">ui/rounded6.png</righttexture>
            </control>
        </control>
    </controls>
</window>