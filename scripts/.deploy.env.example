# Copy to scripts/.deploy.env (gitignored) and fill in your Pi's details.
PI_USER=pi
PI_HOST=raspberrypi.local
# Path to the Kodi addons folder on the device. Typical defaults:
#   Raspberry Pi OS / OSMC: /home/<user>/.kodi/addons
#   LibreELEC:               /storage/.kodi/addons
PI_ADDONS_DIR=/home/pi/.kodi/addons
